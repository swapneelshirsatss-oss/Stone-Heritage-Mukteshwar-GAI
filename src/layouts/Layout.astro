const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const labelMap: Record<string, string> = {
  stay: "Stay",
  experiences: "Experiences",
  "our-story": "Our Story",
  contact: "Contact",
  gallery: "Gallery",
  blog: "Blog",
  "volunteer-work-exchange-mukteshwar": "Volunteer & Work Exchange",
  testimonials: "Testimonials",
  "privacy-policy": "Privacy Policy",
  "terms-conditions": "Terms & Conditions",
  sitemap: "Sitemap",
  search: "Search"
};

const breadcrumbElements = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://thestoneheritage.in/"
  }
];

let curUrl = "https://thestoneheritage.in";
pathSegments.forEach((segment, idx) => {
  curUrl += `/${segment}/`;
  const name = labelMap[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": name,
    "item": curUrl
  });
});

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `https://thestoneheritage.in${Astro.url.pathname}#breadcrumb`,
  "itemListElement": breadcrumbElements
};

const speakableSchema = {
  "@type": "SpeakableSpecification",
  "cssSelector": ["h1", "p"]
};

(structuredData["@graph"] as any[]).push(breadcrumbSchema);
(structuredData["@graph"] as any[]).push(speakableSchema);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/webp" href="/Logo.webp" />
    <link rel="shortcut icon" type="image/webp" href="/Logo.webp" />
    <link rel="apple-touch-icon" href="/Logo.webp" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Hreflang Localization -->
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    
    <!-- Geo & Regional Meta Tags -->
    <meta name="geo.region" content="IN-UT" />
    <meta name="geo.placename" content="Mukteshwar" />
    <meta name="geo.position" content="29.4346873;79.6447246" />
    <meta name="ICBM" content="29.4346873, 79.6447246" />
    
    <!-- Performance Optimizations -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    
    <!-- Preload Critical Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    
    <!-- Preload LCP Image for Homepage -->
    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/best-family-homestay-in-mukteshwar.webp" />
    )}
    
    <!-- Core SEO & Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="llms" href="/llms.txt" />
    
    <!-- Open Graph Meta Tags (for social & AI parsers) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Stone Heritage Mukteshwar" />
    <meta property="og:locale" content="en_IN" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    <!-- Default JSON-LD Structured Data Schema for Homepage -->
    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    
    <!-- Custom Page-Specific Schema -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <!-- Google tag (gtag.js) via Partytown -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-9T01K9RSYE"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9T01K9RSYE');
    </script>

    <!-- Web Vitals Tracking -->
    <script>
      import { reportWebVitals } from '../reportWebVitals';
      reportWebVitals();
    </script>
    
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 font-sans text-stone-900 antialiased selection:bg-accent/20 selection:text-accent">
    <Navbar client:load currentPath={Astro.url.pathname} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>