const { 
  title = 'Best Homestay in Mukteshwar for Families | Stone Heritage',
  description = 'Stone Heritage is a top-rated homestay in Mukteshwar for families, couples & pet owners — authentic Kumaoni heritage stays with panoramic Himalayan views.',
