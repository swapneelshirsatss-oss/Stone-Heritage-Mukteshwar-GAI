  type?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, any>;
}
const { 
  title = 'Best Homestay in Mukteshwar for Families | Stone Heritage',
  description = 'Stone Heritage is a top-rated homestay in Mukteshwar for families, couples & pet owners — authentic Kumaoni heritage stays with panoramic Himalayan views.',
  keywords = 'homestay in mukteshwar, best homestay in mukteshwar, homestay in mukteshwar for families, stone cottage in mukteshwar, pet friendly homestay in mukteshwar, kumaoni heritage stay, homestay near delhi ncr, workation in mukteshwar',
  type = 'website',
  image = 'https://thestoneheritage.in/luxury-heritage-homestay-in-mukteshwar.webp',
  noindex = false,
  schema
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://thestoneheritage.in';
let canonicalUrl = Astro.props.canonicalUrl;

if (!canonicalUrl) {
  let path = Astro.url.pathname.replace(/\/+/g, '/');
  if (path !== '/' && !path.endsWith('/')) {
    path += '/';
  }
  canonicalUrl = `${siteOrigin}${path}`;
} else {
  try {
    const parsed = new URL(canonicalUrl, siteOrigin);
    if (parsed.pathname !== '/' && !parsed.pathname.endsWith('/') && !parsed.pathname.includes('.')) {
      parsed.pathname += '/';
    }
    canonicalUrl = parsed.href;
  } catch (e) {
    // Fallback if URL parsing fails
  }
}

