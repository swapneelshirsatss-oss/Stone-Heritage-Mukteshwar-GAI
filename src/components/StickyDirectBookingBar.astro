---
// StickyDirectBookingBar.astro - High-converting sticky bottom conversion bar & GA4 tracking engine
---

<aside 
  id="sticky-direct-booking-bar"
  class="fixed bottom-0 left-0 right-0 z-[9999] bg-[#602E08] border-t-2 border-[#b36b39] text-[#FDFBF7] shadow-[0_-4px_25px_rgba(0,0,0,0.35)] px-3 sm:px-6 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom,0px))]"
  aria-label="Direct booking conversion bar"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
    
    <!-- Left Text & Direct Value Proposition -->
    <div class="flex flex-col text-left">
      <div class="flex items-center gap-1.5 sm:gap-2">
        <span class="font-serif font-bold text-xs sm:text-base text-[#FDFBF7] tracking-tight leading-tight">
          Stone Heritage Mukteshwar
        </span>
        <span class="text-[10px] sm:text-xs font-bold text-amber-300 bg-amber-950/60 border border-amber-500/30 px-1.5 py-0.5 rounded-md">
          4.9★
        </span>
      </div>
      <p class="font-sans text-[10px] sm:text-xs text-amber-100/90 font-light tracking-wide leading-tight mt-0.5">
        Save 20% Direct • Free Breakfast • ₹0 Pet Fee
      </p>
    </div>

    <!-- Right CTA Button -->
    <div class="flex items-center gap-2 shrink-0">
      <a 
        id="sticky-whatsapp-cta-btn"
        href="https://wa.me/919027844424?text=Hi!%20I%20am%20inquiring%20about%20direct%20booking%20and%20rates%20at%20Stone%20Heritage%20Mukteshwar."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-98 transition-all text-center whitespace-nowrap"
        aria-label="WhatsApp Stone Heritage reservation desk"
      >
        <span class="text-sm sm:text-base leading-none">💬</span>
        <span class="font-bold">WhatsApp Cottages</span>
      </a>
    </div>

  </div>
</aside>

<style is:inline>
  @media (max-width: 768px) {
    body {
      padding-bottom: 70px !important;
    }
  }
  @media (min-width: 769px) {
    body {
      padding-bottom: 56px !important;
    }
  }
</style>

<script is:inline>
  (function initStickyDirectEngine() {
    function updateWhatsAppPath() {
      var btn = document.getElementById('sticky-whatsapp-cta-btn');
      if (!btn) return;
      var path = window.location.pathname || '/';
      var text = "Hi! I am inquiring from thestoneheritage.in" + path + " about cottage availability, the 20% direct booking discount, and free breakfast.";
      btn.href = "https://wa.me/919027844424?text=" + encodeURIComponent(text);
    }

    function fireConversion(eventName, params) {
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, params);
      }
      if (typeof window.dataLayer !== 'undefined' && Array.isArray(window.dataLayer)) {
        window.dataLayer.push(Object.assign({ event: eventName }, params));
      }
    }

    function handleGlobalClick(e) {
      var target = e.target;
      if (!target) return;
      var anchor = target.closest ? target.closest('a') : null;
      if (!anchor) return;

      var href = anchor.getAttribute('href') || '';
      var linkText = (anchor.innerText || anchor.textContent || '').trim().substring(0, 100);

      // 1. WhatsApp tracking
      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
        fireConversion('whatsapp_chat_click', {
          link_url: href,
          link_text: linkText,
          phone_number: '+919027844424',
          page_location: window.location.href
        });
        return;
      }

      // 2. Phone Call tracking
      if (href.indexOf('tel:') === 0) {
        var cleanPhone = href.replace('tel:', '').trim();
        fireConversion('phone_call_click', {
          phone_number: cleanPhone,
          link_text: linkText,
          page_location: window.location.href
        });
        return;
      }

      // 3. Booking Engine tracking
      if (
        href.indexOf('booking.thestoneheritage.in') !== -1 || 
        href === '/stay' || 
        href === '/stay/' || 
        href.indexOf('/stay/') !== -1
      ) {
        fireConversion('booking_engine_click', {
          booking_url: href,
          link_text: linkText,
          page_location: window.location.href
        });
        return;
      }
    }

    // Bind event delegation once globally
    if (!window.__stoneHeritageTrackingBound) {
      document.addEventListener('click', handleGlobalClick, { capture: true });
      window.__stoneHeritageTrackingBound = true;
    }

    // Update WhatsApp link on initial load & Astro page transitions
    updateWhatsAppPath();
    document.addEventListener('astro:page-load', updateWhatsAppPath);
  })();
</script>
