---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { OurStoryContent } from "../../components/our-story/OurStoryContent";

const canonicalUrl = "https://thestoneheritage.in/our-story/";
const pageTitle = "Our Story — Authentic Kumaoni Homestay in Mukteshwar";
const pageDescription = "Discover the story of Stone Heritage Mukteshwar. Meet hosts Akash, Harsh & Priyanka, explore our stone cottage architecture & authentic Kumaoni hospitality.";
const pageKeywords = "our story stone heritage, homestay in mukteshwar, resort in mukteshwar, kumaoni stone cottages, hosts in mukteshwar, heritage stay mukteshwar";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://thestoneheritage.in/our-story/#webpage",
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://thestoneheritage.in/#website",
        "name": "Stone Heritage Mukteshwar",
        "url": "https://thestoneheritage.in/"
      },
      "about": {
        "@type": ["Hotel", "LodgingBusiness", "BedAndBreakfast"],
        "@id": "https://thestoneheritage.in/#hotel",
        "name": "Stone Heritage Mukteshwar",
        "url": "https://thestoneheritage.in/",
        "telephone": "+919027844424",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Bhowali Dhanachuli Rd, South Gola Range",
          "addressLocality": "Mukteshwar",
          "addressRegion": "Uttarakhand",
          "postalCode": "263138",
          "addressCountry": "IN"
        }
      }
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schema={schemaData}
>
  <Breadcrumb />
  <OurStoryContent client:load />
</Layout>
