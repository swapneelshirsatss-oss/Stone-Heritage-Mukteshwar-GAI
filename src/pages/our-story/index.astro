---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { OurStoryContent } from "../../components/our-story/OurStoryContent";

const canonicalUrl = "https://thestoneheritage.in/our-story/";
const pageTitle = "About Us & Our Story | Stone Heritage — Luxury Cottage Homestay & Boutique Resort in Mukteshwar";
const pageDescription = "Discover the story of Stone Heritage Mukteshwar. An authentic luxury cottage homestay & boutique resort hotel in Mukteshwar offering heritage stone cottages and mountain hospitality.";
const pageKeywords = "about us stone heritage, luxury homestay in mukteshwar, cottage homestay mukteshwar, boutique resort in mukteshwar, boutique hotel mukteshwar, best resort hotel in mukteshwar, kumaoni stone cottages, hosts in mukteshwar";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://thestoneheritage.in/our-story/#aboutpage",
      "url": canonicalUrl,
      "name": "About Us & Our Story — Luxury Cottage Homestay & Boutique Resort in Mukteshwar",
      "description": "Discover the story of Stone Heritage Mukteshwar. Meet host Akash, explore our stone cottage architecture & authentic Kumaoni hospitality.",
      "isPartOf": {
        "@id": "https://thestoneheritage.in/#website"
      },
      "mainEntity": {
        "@type": "LodgingBusiness",
        "@id": "https://thestoneheritage.in/#localbusiness",
        "name": "Stone Heritage Mukteshwar"
      }
    },
    {
      "@type": "Person",
      "@id": "https://thestoneheritage.in/our-story/#akash",
      "name": "Akash",
      "jobTitle": "Founder & Host",
      "url": canonicalUrl,
      "worksFor": {
        "@type": "LodgingBusiness",
        "@id": "https://thestoneheritage.in/#localbusiness",
        "name": "Stone Heritage Mukteshwar"
      },
      "description": "Founder of Stone Heritage, dedicated to preserving Kumaon's architectural heritage and authentic Himalayan hospitality.",
      "image": "https://thestoneheritage.in/akash.webp"
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schema={schemaData}
>
  <Breadcrumb />
  <OurStoryContent client:load />
</Layout>
