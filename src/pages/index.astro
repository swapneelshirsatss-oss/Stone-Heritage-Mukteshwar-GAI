---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";
import FloatingWhatsAppButton from "../components/FloatingWhatsAppButton.astro";

import { HeroSection } from "../components/home/HeroSection";
import { IntroSection } from "../components/home/IntroSection";
import { FeaturedRoomsSection } from "../components/home/FeaturedRoomsSection";
import { HomeGallerySection } from "../components/home/HomeGallerySection";
import { TestimonialsSection } from "../components/home/TestimonialsSection";
import { ValuePropSection } from "../components/home/ValuePropSection";
import { BookingCtaSection } from "../components/home/BookingCtaSection";
import { LocalAttractionsSection } from "../components/home/LocalAttractionsSection";
import { PartnersSection } from "../components/home/PartnersSection";
import { BlogCarouselSection } from "../components/home/BlogCarouselSection";
import { FaqAccordion } from "../components/FaqAccordion";
import { LocationSection } from "../components/home/LocationSection";

const allPosts = await getCollection('blog');
const formattedPosts = allPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date,
  author: post.data.author,
  category: post.data.category,
  image: post.data.image,
  readTime: post.data.readTime,
}));
formattedPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---
<Layout 
  title="Homestay in Mukteshwar for Families | Stone Heritage" 
  description="Stone Heritage is a top-rated homestay in Mukteshwar for families and couples. Enjoy panoramic Himalayan views & warm Kumaoni hospitality near Delhi NCR."
  keywords="homestay in mukteshwar, best homestay in mukteshwar, homestay in mukteshwar for families, stone cottage in mukteshwar, pet friendly homestay in mukteshwar, kumaoni heritage stay, homestay near delhi ncr, workation in mukteshwar"
>
  <div class="flex flex-col">
    <HeroSection client:load />
    <IntroSection client:visible />
    <FeaturedRoomsSection client:visible />
    <HomeGallerySection client:visible />
    <TestimonialsSection client:visible />
    <ValuePropSection client:visible />
    <BookingCtaSection client:visible />
    <LocalAttractionsSection client:visible />
    <PartnersSection client:visible />
    <BlogCarouselSection posts={formattedPosts} client:visible />
    <FaqAccordion client:visible />
    <LocationSection client:visible />
  </div>
  <FloatingWhatsAppButton />
</Layout>

