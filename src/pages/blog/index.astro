---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Blog from "../../components/react-pages/Blog.astro";

const canonicalUrl = "https://thestoneheritage.in/blog/";
const pageTitle = "Mukteshwar Travel Blog & Guides | Stone Heritage Mukteshwar";
const pageDescription = "Read the Stone Heritage Mukteshwar travel blog for local sight-seeing guides, road trip itineraries from Delhi NCR, bird watching & Kumaoni culture tips.";
const pageKeywords = "mukteshwar travel blog, mukteshwar travel guides, delhi to mukteshwar road trip, things to do in mukteshwar blog, kumaoni heritage blog";

const allPosts = await getCollection('blog');

// Format posts for the component
const formattedPosts = allPosts.map(post => ({
  id: post.slug,
  slug: post.slug,
  title: post.data.title,
  excerpt: post.data.excerpt,
  metaDescription: post.data.metaDescription,
  date: post.data.date,
  author: post.data.author,
  category: post.data.category,
  image: post.data.image,
  readTime: post.data.readTime,
}));

// Sort by date descending
formattedPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://thestoneheritage.in/blog/#blog",
      "url": canonicalUrl,
      "name": "Discover Mukteshwar — Stone Heritage Blog",
      "description": "Travel stories, local insights, and expert guides to help you make the most of your stay at Stone Heritage Mukteshwar.",
      "isPartOf": { "@id": "https://thestoneheritage.in/#website" },
      "publisher": {
        "@type": ["BedAndBreakfast", "Resort", "Hotel"],
        "@id": "https://thestoneheritage.in/#localbusiness",
        "name": "Stone Heritage Mukteshwar",
        "alternateName": ["Stone Heritage Resort", "Stone Heritage", "Stone Heritage Homestay"],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.8",
          "reviewCount": "267",
          "bestRating": "5",
          "worstRating": "1"
        }
      },
      "blogPost": formattedPosts.map(post => ({
        "@type": "BlogPosting",
        "headline": post.title,
        "url": `https://thestoneheritage.in/blog/${post.slug}/`,
        "datePublished": new Date(post.date).toISOString().split('T')[0],
        "dateModified": new Date(post.date).toISOString().split('T')[0],
        "author": { "@type": "Person", "name": post.author },
        "description": post.metaDescription || post.excerpt
      }))
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schema={schemaData}
>
  <Breadcrumb />
  <Blog posts={formattedPosts} />
</Layout>
