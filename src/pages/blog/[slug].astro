---
import { getCollection, render } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function extractFaqs(markdown: string) {
  if (!markdown) return [];
  const faqSectionMatch = markdown.match(/## Frequently Asked Questions[^\n]*\n([\s\S]*?)(?=\n## |\n---|\s*$)/i);
  if (!faqSectionMatch) return [];
  
  const faqContent = faqSectionMatch[1];
  const qnaBlocks = faqContent.split(/\n(?=###\s+)/);
  const faqs: { question: string; answer: string }[] = [];
  
  for (const block of qnaBlocks) {
    const match = block.match(/^###\s+(?:(?:\d+\.|\bQ\d*\.?)\s*)?([^\n]+)\n+([\s\S]+)$/);
    if (match) {
      const question = match[1].trim();
      const answer = match[2]
        .replace(/^(?:\*\*A:\*\*|A:)\s*/i, '')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/\*\*([^*]+)\*\*/g, '$1')
        .replace(/\*([^*]+)\*/g, '$1')
        .trim();
      if (question && answer) {
        faqs.push({ question, answer });
      }
    }
  }
  return faqs;
}

const extractedFaqs = extractFaqs(post.body);
const postImageUrl = post.data.image.startsWith('http') ? post.data.image : `https://thestoneheritage.in${post.data.image}`;

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["BedAndBreakfast", "Resort", "Hotel"],
      "@id": "https://thestoneheritage.in/#localbusiness",
      "name": "Stone Heritage Mukteshwar",
      "url": "https://thestoneheritage.in/",
      "logo": "https://thestoneheritage.in/Logo.webp",
      "telephone": "+91-9027844424",
      "email": "thestoneheritage@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bhowali Dhanachuli Rd, South Gola Range",
        "addressLocality": "Mukteshwar",
        "addressRegion": "Uttarakhand",
        "postalCode": "263138",
        "addressCountry": "IN"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 29.4346202, "longitude": 79.6446521 },
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "250", "bestRating": "5" },
      "priceRange": "₹1,500 - ₹15,000",
      "petsAllowed": true,
      "checkinTime": "13:00",
      "checkoutTime": "11:00",
      "sameAs": [
        "https://www.facebook.com/thestoneheritage/",
        "https://www.instagram.com/thestoneheritage/",
        "https://www.youtube.com/@StoneHeritageMukteshwar",
        "https://maps.google.com/maps?cid=5074157692820223333",
        "https://www.tripadvisor.in/Hotel_Review-g1162527-d33498951-Reviews-Stone_Heritage_Mukteshwar-Mukteshwar_Nainital_District_Uttarakhand.html"
      ]
    },
    {
      "@type": "ImageObject",
      "@id": `${postImageUrl}/#primaryimage`,
      "url": postImageUrl,
      "contentUrl": postImageUrl,
      "caption": post.data.title,
      "description": post.data.excerpt || post.data.metaDescription
    },
    {
      "@type": ["BlogPosting", "TravelArticle"],
      "@id": `https://thestoneheritage.in/blog/${post.slug}/#article`,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://thestoneheritage.in/blog/${post.slug}/`
      },
      "headline": post.data.title,
      "description": post.data.metaDescription || post.data.excerpt,
      "image": { "@id": `${postImageUrl}/#primaryimage` },
      "inLanguage": "en-IN",
      "isAccessibleForFree": true,
      "datePublished": new Date(post.data.date).toISOString(),
      "dateModified": new Date(post.data.date).toISOString(),
      "author": {
        "@type": "Person",
        "@id": "https://thestoneheritage.in/our-story/#akash",
        "name": post.data.author,
        "url": "https://thestoneheritage.in/our-story/#hosts",
        "image": "https://thestoneheritage.in/images/property/akash.webp",
        "jobTitle": "Founder & Local Mountain Host",
        "description": "Founder and host at Stone Heritage Mukteshwar, seasoned Himalayan traveler, and local mountain guide.",
        "worksFor": {
          "@type": "Organization",
          "name": "Stone Heritage Mukteshwar",
          "url": "https://thestoneheritage.in/"
        }
      },
      "publisher": {
        "@id": "https://thestoneheritage.in/#localbusiness"
      },
      "about": [
        {
          "@type": "TouristDestination",
          "name": "Mukteshwar",
          "description": "A tranquil hill station in Uttarakhand known for 180° Himalayan views, Chauli Ki Jali cliffs, Mukteshwar Dham Temple, fruit orchards, and stargazing.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mukteshwar",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4722,
            "longitude": 79.6472
          }
        }
      ],
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".prose > p:first-of-type"]
      }
    },
    ...(extractedFaqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `https://thestoneheritage.in/blog/${post.slug}/#faq`,
      "mainEntity": extractedFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }] : [])
  ]
};
---

<Layout 
  title={post.data.metaTitle || `${post.data.title} | Stone Heritage`} 
  description={post.data.metaDescription || post.data.excerpt} 
  schema={blogSchema}
  image={post.data.image.startsWith('http') ? post.data.image : `https://thestoneheritage.in${post.data.image}`}
>
  <Breadcrumb currentTitle={post.data.title} />
  <article class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      <span class="text-accent font-sans font-medium tracking-[0.2em] uppercase text-xs mb-6 block">{post.data.category}</span>
      <h1 class="text-4xl md:text-6xl font-serif font-medium mb-6 text-primary tracking-tight">{post.data.title}</h1>
      <div class="flex justify-center items-center gap-6 text-primary/60 text-sm">
        <span>{post.data.date}</span>
        <span>•</span>
        <span>{post.data.author}</span>
        <span>•</span>
        <span>{post.data.readTime}</span>
      </div>
    </div>
    
    <div class="aspect-[21/9] overflow-hidden rounded-2xl mb-12 shadow-md">
      <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" width={1200} height={675} />
    </div>

    <div class="prose prose-lg max-w-none text-stone-700 font-light leading-relaxed prose-headings:font-serif prose-headings:text-primary prose-a:text-accent hover:prose-a:underline">
      <Content />
    </div>

    <!-- Author Bio Card (Google E-E-A-T Signal) -->
    <div class="mt-16 pt-8 border-t border-stone-200 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-100 flex flex-col sm:flex-row items-center gap-6">
      <img 
        src={post.data.author.includes('Akash') ? '/images/property/akash.webp' : '/images/property/best-family-homestay-in-mukteshwar.webp'} 
        alt={post.data.author} 
        class="w-20 h-20 rounded-full object-cover border-2 border-primary/20 shrink-0"
      />
      <div>
        <span class="text-xs uppercase tracking-wider text-secondary font-semibold">Written by Local Host & Expert</span>
        <h3 class="text-xl font-bold text-primary mt-0.5 mb-2">{post.data.author}</h3>
        <p class="text-sm text-stone-600 font-light leading-relaxed mb-3">
          Local host and mountain guide at Stone Heritage Mukteshwar. Sharing authentic Kumaoni travel guides, trekking routes, and mountain lifestyle insights.
        </p>
        <a href="/our-story/#hosts" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
          Learn more about our hosts on Our Story &rarr;
        </a>
      </div>
    </div>

    <!-- Follow on Google Preferred Source -->
    <div class="mt-6 p-6 bg-stone-50 border border-stone-200/80 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm text-primary shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-primary">Follow Stone Heritage on Google</h4>
          <p class="text-xs text-stone-600">Add us to your preferred sources to get the latest Mukteshwar travel guides & updates.</p>
        </div>
      </div>
      <div class="g-preferred-source shrink-0" data-domain="thestoneheritage.in" google-add-preferred-source-btn data-theme="light" data-lang="en"></div>
    </div>
  </article>
</Layout>
