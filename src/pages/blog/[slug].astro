---
import { getCollection, render } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const isTopThingsToDo = post.slug === 'top-5-things-to-do-in-mukteshwar';

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["BlogPosting", "TravelArticle"],
      "@id": `https://thestoneheritage.in/blog/${post.slug}/#article`,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://thestoneheritage.in/blog/${post.slug}/`
      },
      "headline": post.data.title,
      "description": post.data.excerpt,
      "image": [
        post.data.image.startsWith('http') ? post.data.image : `https://thestoneheritage.in${post.data.image}`
      ],
      "inLanguage": "en-IN",
      "isAccessibleForFree": true,
      "datePublished": new Date(post.data.date).toISOString(),
      "dateModified": new Date("2026-07-28").toISOString(),
      "author": {
        "@type": "Person",
        "@id": "https://thestoneheritage.in/our-story/#akash",
        "name": post.data.author,
        "url": "https://thestoneheritage.in/our-story/#hosts",
        "image": "https://thestoneheritage.in/akash.webp",
        "jobTitle": "Founder & Local Mountain Host",
        "description": "Founder and local host at Stone Heritage Mukteshwar, seasoned Himalayan traveler, and local mountain guide.",
        "worksFor": {
          "@type": "Organization",
          "name": "Stone Heritage Mukteshwar",
          "url": "https://thestoneheritage.in/"
        }
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://thestoneheritage.in/#organization",
        "name": "Stone Heritage Mukteshwar",
        "url": "https://thestoneheritage.in/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://thestoneheritage.in/Logo.webp",
          "width": 500,
          "height": 500
        }
      },
      "about": [
        {
          "@type": "TouristDestination",
          "name": "Mukteshwar",
          "description": "A quiet hill station in Uttarakhand known for panoramic Himalayan views, Chauli Ki Jali, Mukteshwar Dham Temple, and stargazing.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mukteshwar",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4722,
            "longitude": 79.6472
          }
        }
      ]
    },
    ...(isTopThingsToDo ? [{
      "@type": "FAQPage",
      "@id": `https://thestoneheritage.in/blog/${post.slug}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many days are sufficient for a trip to Mukteshwar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 3-day, 2-night stay is ideal to visit key attractions like Chauli Ki Jali, Mukteshwar Temple, Bhalu Gaad Waterfall, and experience a relaxed evening of stargazing and Kumaoni food without feeling rushed."
          }
        },
        {
          "@type": "Question",
          "name": "How far is Stone Heritage Homestay from Chauli Ki Jali and Mukteshwar Temple?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stone Heritage is located directly in Mukteshwar, just 1.5 to 2 km away from both Mukteshwar Dham Temple and Chauli Ki Jali cliff."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Bhalu Gaad trek safe for families and children?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the 2 km trail is easy-to-moderate and suitable for families and kids. We recommend wearing proper shoes with good grip as rocks near the stream can be slippery."
          }
        },
        {
          "@type": "Question",
          "name": "Can we see snow in Mukteshwar during winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mukteshwar receives occasional snowfall during peak winter months, usually between late December and late January. Even without snow, winter offers the sharpest, clearest views of snow-clad Himalayan peaks."
          }
        },
        {
          "@type": "Question",
          "name": "What is the nearest railway station and airport to Mukteshwar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The nearest railway station is Kathgodam (KGM), located about 62 km away (approx. 2 to 2.5 hours by taxi). The nearest airport is Pantnagar (PGH), about 95 km away."
          }
        }
      ]
    }] : [])
  ]
};
---

<Layout title={`${post.data.title} | Stone Heritage`} description={post.data.excerpt} schema={blogSchema}>
  <Breadcrumb currentTitle={post.data.title} />
  <article class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      <span class="text-accent font-sans font-medium tracking-[0.2em] uppercase text-xs mb-6 block">{post.data.category}</span>
      <h1 class="text-4xl md:text-6xl font-serif font-medium mb-6 text-primary tracking-tight">{post.data.title}</h1>
      <div class="flex justify-center items-center gap-6 text-primary/60 text-sm">
        <span>{post.data.date}</span>
        <span>•</span>
        <span>{post.data.author}</span>
        <span>•</span>
        <span>{post.data.readTime}</span>
      </div>
    </div>
    
    <div class="aspect-[21/9] overflow-hidden rounded-2xl mb-12 shadow-md">
      <Image src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" width={1200} height={675} />
    </div>

    <div class="prose prose-lg max-w-none text-stone-700 font-light leading-relaxed prose-headings:font-serif prose-headings:text-primary prose-a:text-accent hover:prose-a:underline">
      <Content />
    </div>

    <!-- Author Bio Card (Google E-E-A-T Signal) -->
    <div class="mt-16 pt-8 border-t border-stone-200 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-100 flex flex-col sm:flex-row items-center gap-6">
      <img 
        src={post.data.author.includes('Akash') ? '/akash.webp' : '/best-family-homestay-in-mukteshwar.webp'} 
        alt={post.data.author} 
        class="w-20 h-20 rounded-full object-cover border-2 border-primary/20 shrink-0"
      />
      <div>
        <span class="text-xs uppercase tracking-wider text-secondary font-semibold">Written by Local Host & Expert</span>
        <h3 class="text-xl font-bold text-primary mt-0.5 mb-2">{post.data.author}</h3>
        <p class="text-sm text-stone-600 font-light leading-relaxed mb-3">
          Local host and mountain guide at Stone Heritage Mukteshwar. Sharing authentic Kumaoni travel guides, trekking routes, and mountain lifestyle insights.
        </p>
        <a href="/our-story/#hosts" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
          Learn more about our hosts on Our Story &rarr;
        </a>
      </div>
    </div>
  </article>
</Layout>
