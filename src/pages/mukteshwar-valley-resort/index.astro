                      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span class="text-[11px] font-semibold">5/5 on Google</span>
                  </div>
                </div>

                <div class="mb-3 flex flex-wrap items-center gap-2">
                  {review.tag && (
                    <span class="text-[11px] font-medium text-stone-600 bg-stone-100/90 px-2 py-0.5 rounded">
                      {review.tag}
                    </span>
                  )}
                  {review.highlight && (
                    <span class="text-[10px] bg-amber-100/80 text-amber-900 font-semibold px-2 py-0.5 rounded-full">
                      {review.highlight}
                    </span>
                  )}
                </div>

                <p class="text-xs sm:text-sm text-stone-700 italic font-light leading-relaxed mb-4 whitespace-pre-line">
                  "{review.text}"
                </p>
              </div>

              <div class="pt-4 border-t border-stone-100 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="block text-xs font-bold text-primary">{review.name}</span>
                  <span class="text-[11px] text-stone-400">{review.timeAgo}</span>
                </div>
                <div class="flex items-center gap-2.5 text-[11px] text-stone-500 font-medium">
                  <span>Rooms <strong class="text-stone-800">{review.rooms}</strong></span>
                  <span>•</span>
                  <span>Service <strong class="text-stone-800">{review.service}</strong></span>
                  <span>•</span>
                  <span>Location <strong class="text-stone-800">{review.location}</strong></span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a 
            href="https://maps.google.com/maps?cid=5074157692820223333" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs sm:text-sm text-accent hover:text-primary font-semibold underline underline-offset-4 inline-flex items-center gap-1.5"
          >
            <span>Read All 250+ Verified Google Reviews on Google Maps →</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 9. FREQUENTLY ASKED QUESTIONS (FAQ) -->
    <section class="py-16 md:py-24 bg-white border-b border-stone-200" id="faqs">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-14">
          <span class="text-xs font-semibold tracking-widest text-accent uppercase block mb-2">
            Helpful Information
          </span>
          <h2 class="text-2xl sm:text-4xl font-serif font-bold text-primary tracking-tight mb-4">
            Frequently Asked Questions
          </h2>
          <p class="text-stone-600 text-sm font-light">
            Everything you need to know about staying at Stone Heritage Mukteshwar Valley Resort.
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details class="group bg-stone-50 rounded-xl p-5 border border-stone-200 open:border-accent/50 open:bg-amber-50/20 transition-all">
              <summary class="flex justify-between items-center cursor-pointer list-none text-left">
                <span class="text-sm sm:text-base font-serif font-bold text-primary group-open:text-accent pr-4">
                  {faq.q}
                </span>
                <span class="text-accent transition-transform duration-200 group-open:rotate-180 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pt-3 border-t border-stone-200/60 text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>

      </div>
    </section>

    <!-- 10. GOOGLE MAPS INTERACTIVE EMBED -->
    <section class="py-14 bg-stone-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <span class="text-xs font-semibold tracking-widest text-accent uppercase block mb-1">
            Map Location
          </span>
          <h3 class="text-xl sm:text-2xl font-serif font-bold text-primary">
            Find Us on Bhowali-Dhanachuli Road
          </h3>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-lg border border-stone-300 h-80 sm:h-96 w-full">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3474.798426132153!2d79.64472459999999!3d29.434687300000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39a0bd7d35a2e497%3A0x466b07899edd7565!2sStone%20Heritage%20Mukteshwar!5e0!3m2!1sen!2sin!4v1782816534338!5m2!1sen!2sin" 
            title="Google Maps Location of Stone Heritage Mukteshwar"
            width="100%" 
            height="100%" 
            style="border: 0;" 
            allowfullscreen 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- 11. FINAL BOOKING CALL TO ACTION -->
    <section class="py-16 md:py-20 bg-stone-900 text-stone-100 text-center relative overflow-hidden">
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-xs uppercase font-bold tracking-widest text-amber-300 block mb-3">
          Plan Your Mukteshwar Escape
        </span>
        <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-white mb-6">
          Reserve Your Handcrafted Stone Cottage in Mukteshwar
        </h2>
        <p class="text-stone-300 text-sm sm:text-base font-light max-w-2xl mx-auto mb-8 leading-relaxed">
          Escape city noise and awaken to 180° Himalayan snow peaks, wholesome pure vegetarian dining, and warm Kumaoni hospitality. Book directly to unlock guaranteed lowest prices and complimentary evening bonfires.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="https://booking.thestoneheritage.in/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-accent text-white font-bold text-sm sm:text-base hover:bg-accent/90 shadow-xl hover:scale-[1.02] active:scale-98 transition-all flex items-center justify-center gap-2"
          >
            <Calendar className="w-5 h-5" />
            <span>Book Direct & Save 20%</span>
          </a>

          <a 
            href="https://wa.me/919027844424?text=Hi%20Stone%20Heritage!%20I%20would%20like%20to%20reserve%20a%20cottage%20stay.%20Please%20share%20room%20options%20and%20rates." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-stone-800 text-stone-100 font-semibold text-sm sm:text-base border border-stone-700 hover:bg-stone-700 transition-all flex items-center justify-center gap-2"
          >
            <Phone className="w-4 h-4 text-accent" />
            <span>Connect on WhatsApp Desk</span>
          </a>
        </div>
      </div>
    </section>

  </div>

  <!-- Floating Desktop WhatsApp Concierge Button -->
  <FloatingWhatsAppButton />

  <!-- Persistent Mobile Conversion Bar (<768px viewports) -->
  <MobileBottomActionBar />
</Layout>
