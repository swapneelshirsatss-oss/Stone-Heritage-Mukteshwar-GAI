---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Testimonials from "../../components/react-pages/Testimonials.astro";

import { testimonials } from "../../data/testimonials";

const canonicalUrl = "https://thestoneheritage.in/testimonials/";
const pageTitle = "Guest Reviews & Testimonials | Stone Heritage Mukteshwar";
const pageDescription = "Read authentic guest reviews about their stay at Stone Heritage Mukteshwar. With a 4.9-star rating based on 250+ Google reviews, discover why we are top-rated.";
const pageKeywords = "stone heritage mukteshwar reviews, guest testimonials mukteshwar, best homestay reviews mukteshwar";

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Stone Heritage Mukteshwar Stay",
  "description": "Authentic Kumaoni stone cottage homestay rooms and suites in Mukteshwar.",
  "image": "https://thestoneheritage.in/best-family-homestay-in-mukteshwar.webp",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "250",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": testimonials.slice(0, 10).map(t => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": t.name },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "reviewBody": t.text
  }))
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schema={reviewSchema}
>
  <Breadcrumb />
  <Testimonials />
</Layout>