---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Testimonials from "../../components/react-pages/Testimonials.astro";

import { testimonials } from "../../data/testimonials";

const canonicalUrl = "https://thestoneheritage.in/testimonials/";
const pageTitle = "Guest Reviews & Testimonials | Stone Heritage Mukteshwar";
const pageDescription = "Read authentic guest reviews about their stay at Stone Heritage Mukteshwar. With a 4.8-star rating based on 267+ Google reviews, discover why we are top-rated.";
const pageKeywords = "stone heritage mukteshwar reviews, guest testimonials mukteshwar, best homestay reviews mukteshwar";

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": ["BedAndBreakfast", "Resort", "Hotel"],
  "@id": "https://thestoneheritage.in/#localbusiness",
  "name": "Stone Heritage Mukteshwar",
  "alternateName": [
    "Stone Heritage Resort",
    "Stone Heritage",
    "Stone Heritage Homestay"
  ],
  "url": "https://thestoneheritage.in/",
  "description": "Authentic Kumaoni stone cottage homestay rooms and suites in Mukteshwar.",
  "image": "https://thestoneheritage.in/images/property/best-family-homestay-in-mukteshwar.webp",
  "telephone": "+919027844424",
  "priceRange": "₹1,500 - ₹15,000",
  "petsAllowed": true,
  "checkinTime": "13:00",
  "checkoutTime": "11:00",
  "sameAs": [
    "https://www.facebook.com/thestoneheritage/",
    "https://www.instagram.com/thestoneheritage/",
    "https://www.youtube.com/@StoneHeritageMukteshwar",
    "https://maps.google.com/maps?cid=5074157692820223333",
    "https://www.tripadvisor.in/Hotel_Review-g1162527-d33498951-Reviews-Stone_Heritage_Mukteshwar-Mukteshwar_Nainital_District_Uttarakhand.html",
    "https://www.google.com/travel/hotels/entity/ChkI5er19pnxwbVGGg0vZy8xMXhjeWtwNzJwEAE"
  ],
  "amenityFeature": [
    {
      "@type": "LocationFeatureSpecification",
      "name": "Fresh Food & Breakfast Available",
      "value": true
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Pure Vegetarian Home-Cooked Kumaoni Meals",
      "value": true
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "267",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": testimonials.slice(0, 10).map(t => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": t.name },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "reviewBody": t.text
  }))
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  schema={reviewSchema}
>
  <Breadcrumb />
  <Testimonials />
</Layout>
