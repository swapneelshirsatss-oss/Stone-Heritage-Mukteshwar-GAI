---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { Stay } from "../../components/react-pages/Stay";
import { rooms } from "../../data/hotelData";

const canonicalUrl = "https://thestoneheritage.in/stay/";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://thestoneheritage.in/stay/#webpage",
      "url": canonicalUrl,
      "name": "Stone Cottage Homestay in Mukteshwar — Rooms & Suites (2026)",
      "isPartOf": {
        "@id": "https://thestoneheritage.in/#website"
      },
      "about": {
        "@id": "https://thestoneheritage.in/#localbusiness"
      }
    },
    {
      "@type": "ItemList",
      "name": "Stone Cottage Rooms at Stone Heritage Mukteshwar",
      "numberOfItems": rooms.length,
      "itemListElement": rooms.map((room, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": room.isSuite ? ["HotelRoom", "Suite"] : "HotelRoom",
          "name": room.name,
          "description": room.description,
          "occupancy": { "@type": "QuantitativeValue", "maxValue": room.maxOccupancy },
          "bed": { "@type": "BedDetails", "typeOfBed": room.bedType },
          "amenityFeature": room.amenitiesList.map((amenity) => ({
            "@type": "LocationFeatureSpecification",
            "name": amenity,
            "value": true
          }))
        }
      }))
    }
  ]
};
---

<Layout 
  title="Best Homestay in Mukteshwar | 9 Heritage Stone Cottages & Suites (2026)" 
  description="Stay at the best homestay in Mukteshwar (4.9★). 9 luxury stone cottages, family suites, 180° Himalayan snow peak views & pure veg dining. Book direct to save 20%!"
  keywords="best homestay in mukteshwar, homestay in mukteshwar for family, stone cottage homestay in mukteshwar, stone cottage in mukteshwar, luxury stone cottage mukteshwar, vintage family rooms mukteshwar, homestay rooms in mukteshwar"
  canonicalUrl={canonicalUrl}
  schema={schemaData}
>
  <Breadcrumb />
  <Stay client:visible />
</Layout>
