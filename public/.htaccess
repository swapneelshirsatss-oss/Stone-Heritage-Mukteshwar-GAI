<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Force non-WWW (thestoneheritage.in)
RewriteCond %{HTTP_HOST} ^www\.thestoneheritage\.in$ [NC]
RewriteRule ^(.*)$ https://thestoneheritage.in/$1 [R=301,L]

# 2.5 Specific Case-Insensitive Canonical Redirects (Prevents 404s on /Stay, /Experiences, etc.)
RewriteCond %{REQUEST_URI} !^/stay/$
RewriteRule ^stay/?$ https://thestoneheritage.in/stay/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/experiences/$
RewriteRule ^experiences/?$ https://thestoneheritage.in/experiences/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/gallery/$
RewriteRule ^gallery/?$ https://thestoneheritage.in/gallery/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/contact/$
RewriteRule ^contact/?$ https://thestoneheritage.in/contact/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/our-story/$
RewriteRule ^our-story/?$ https://thestoneheritage.in/our-story/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/testimonials/$
RewriteRule ^testimonials/?$ https://thestoneheritage.in/testimonials/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/volunteer-work-exchange-mukteshwar/$
RewriteRule ^volunteer/?$ https://thestoneheritage.in/volunteer-work-exchange-mukteshwar/ [R=301,L,NC]

RewriteRule ^workation-in-mukteshwar/?$ https://thestoneheritage.in/blog/workation-in-mukteshwar/ [R=301,L,NC]

# 3. Force trailing slash on all extensionless directory paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^(.*)$ https://thestoneheritage.in/$1/ [R=301,L]

# 4. Resolve extensionless trailing slash requests directly to physical sub-directories
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

# 5. Enforce true hard 404 response status for non-existent entities
ErrorDocument 404 /404.html
</IfModule>
