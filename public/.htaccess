<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0. Redirect Hostinger preview/staging subdomain to canonical domain immediately
RewriteCond %{HTTP_HOST} hostingersite\.com$ [NC]
RewriteRule ^(.*)$ https://thestoneheritage.in/$1 [R=301,L]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://thestoneheritage.in/$1 [R=301,L]

# 2. Force non-WWW (thestoneheritage.in)
RewriteCond %{HTTP_HOST} ^www\.thestoneheritage\.in$ [NC]
RewriteRule ^(.*)$ https://thestoneheritage.in/$1 [R=301,L]

# 2.5 Specific Case-Insensitive Canonical Redirects (Prevents 404s on /Stay, /Experiences, etc.)
RewriteCond %{REQUEST_URI} !^/stay/$
RewriteRule ^stay/?$ https://thestoneheritage.in/stay/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/experiences/$
RewriteRule ^experiences/?$ https://thestoneheritage.in/experiences/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/gallery/$
RewriteRule ^gallery/?$ https://thestoneheritage.in/gallery/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/contact/$
RewriteRule ^contact/?$ https://thestoneheritage.in/contact/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/our-story/$
RewriteRule ^our-story/?$ https://thestoneheritage.in/our-story/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/testimonials/$
RewriteRule ^testimonials/?$ https://thestoneheritage.in/testimonials/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/volunteer-work-exchange-mukteshwar/$
RewriteRule ^volunteer/?$ https://thestoneheritage.in/volunteer-work-exchange-mukteshwar/ [R=301,L,NC]

RewriteRule ^workation-in-mukteshwar/?$ https://thestoneheritage.in/blog/workation-in-mukteshwar/ [R=301,L,NC]

RewriteCond %{REQUEST_URI} !^/blog/pet-friendly-homestay-in-mukteshwar/$
RewriteRule ^blog/pet-friendly-homestay/?$ https://thestoneheritage.in/blog/pet-friendly-homestay-in-mukteshwar/ [R=301,L,NC]

# 3. Force trailing slash on all extensionless directory paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^(.*)$ https://thestoneheritage.in/$1/ [R=301,L]

# 4. Resolve extensionless trailing slash requests directly to physical sub-directories
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

# 5. Enforce true hard 404 response status for non-existent entities
ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_headers.c>
    # Content Security Policy (CSP) allowing Google Tag Manager, GA4, Google Ads, Google Fonts, Maps, and Google Tag Assistant
    Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://ssl.google-analytics.com https://news.google.com https://*.google.com https://*.google.co.in https://*.gstatic.com https://*.googleadservices.com https://*.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://tagmanager.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.googletagmanager.com https://tagmanager.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.doubleclick.net https://*.googleadservices.com https://*.google.com https://*.google.co.in https://*.gstatic.com https://maps.gstatic.com https://maps.googleapis.com https://*.tripadvisor.com; connect-src 'self' https://www.googletagmanager.com https://tagmanager.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.doubleclick.net https://*.googleadservices.com https://news.google.com https://*.google.com https://*.google.co.in; frame-src 'self' https://www.googletagmanager.com https://tagmanager.google.com https://*.doubleclick.net https://*.googleadservices.com https://www.google.com https://maps.google.com https://*.google.com https://*.google.co.in; frame-ancestors 'self' https://tagassistant.google.com; upgrade-insecure-requests;"
</IfModule>

